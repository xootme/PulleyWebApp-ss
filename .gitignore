# ── Virtual Environment ──────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Third-party tool binaries (download separately, see tools/sfa/README.md) ─
tools/sfa/*.exe
tools/sfa/*.zip
tools/sfa/*.msi
tools/sfa/*.pdf
tools/sfa/*.xlsx

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
# generated STEP/DXF/STL files from test runs
test_output/
# fuzz_pulley.py JSONL logs
fuzz_results/
# tests/run_tests.py failure/skip summary from the most recent run
tests/last_failures.txt
tests/last_skipped.txt
# runtime metrics and subscriber data (lives on Render disk, not in repo)
logs/

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Claude Code ──────────────────────────────────────────────────────────────
.claude/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Local dev / scratch files ────────────────────────────────────────────────
testing.html
*.log
run_ss_dev.bat
flask_ss_err.txt
flask_ss_output.txt
flask_err.txt
flask_output.txt

# ── Benchmarks ───────────────────────────────────────────────────────────────
# Raw JSON scratch output — Perf_History.csv is committed instead
.benchmarks/

# ── Packaging ─────────────────────────────────────────────────────────────────
releases/           # built .zip release artefacts
licences/           # per-customer licence.lic files
